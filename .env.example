NEXT_PUBLIC_SITE_URL=https://www.mkgassafety.co.uk
# Confirm Ram's actual email and registration before using them.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GAS_SAFE_NUMBER=
# Optional HTTPS endpoint returning a successful HTTP status only after accepting an enquiry.
# With email only, the form opens an addressed email draft and clearly asks the visitor to send it.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Keep private previews out of search indexes. Enable only on the final public domain.
NEXT_PUBLIC_ENABLE_INDEXING=false
